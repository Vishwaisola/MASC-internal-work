%% MASC project timeline -- the figure on the "Project timeline" slide.
%% Dates come from the project schedule, not from memory. Keep this file as the single source
%% of truth and let the build render the PNG; do not edit the PNG by hand.
%% Render: npx @mermaid-js/mermaid-cli@11 -i project-timeline.mmd -o project-timeline.png -w 1300 -s 2 -b white
%% Each phase is its own section so its full description sits in the left margin, out of the
%% bar's way. Status (done/planned/target) is colour-only -- see the legend under the image in
%% the slide markdown -- so bars carry no readable inline text (mermaid needs a non-empty task
%% name, hence the single middle-dot placeholder). The Accelerated schedule row reuses the crit
%% (blue) styling so its text renders white automatically; only the dash pattern is custom.
%%{init: {'theme':'base','themeCSS':'* { font-family: Helvetica Neue, Helvetica, Arial, sans-serif !important; } .milestoneText { font-style: normal !important; } .grid .tick text { display: none; } .grid ~ .grid .tick text { display: block; font-size: 13px; } #accel { stroke-dasharray: 6,4; }','themeVariables':{'fontFamily':'Helvetica Neue, Arial, sans-serif','taskBkgColor':'#37782C','taskBorderColor':'#37782C','taskTextColor':'#ffffff','taskTextDarkColor':'#194722','taskTextOutsideColor':'#194722','critBkgColor':'#2E7DD1','critBorderColor':'#2E7DD1','doneTaskBkgColor':'#8EBF3F','doneTaskBorderColor':'#8EBF3F','doneTaskTextColor':'#194722','sectionBkgColor':'#EFF6E9','altSectionBkgColor':'#ffffff','sectionBkgColor2':'#EFF6E9','gridColor':'#D7E6C9','textColor':'#194722'},'gantt':{'barHeight':26,'barGap':6,'fontSize':16,'sectionFontSize':16,'leftPadding':340,'topPadding':20,'rightPadding':40,'topAxis':true}}}%%
gantt
    todayMarker off
    dateFormat YYYY-MM-DD
    axisFormat %b %d
    tickInterval 1week
    weekday monday
    section Finalized Modernization Plan
    .                                       :done, k0, 2026-09-08, 2026-09-09
    section Phase 0: Dependency Pruning
    .                                       :done, p0, 2026-09-10, 2026-09-22
    section Phase 1: Foundation & Config
    .                                       :done, p1, 2026-09-10, 2026-09-22
    section Phase 2: Host & Framework
    .                                       :done, p2, 2026-09-23, 2026-09-29
    section Phase 3: Data & Identity
    .                                       :done, p3, 2026-10-02, 2026-10-07
    section Phase 4: Observability
    .                                       :done, p4, 2026-10-08, 2026-10-15
    section Phase 5: Cloud Deployment
    .                                       :done, p5, 2026-10-08, 2026-10-15
    section Test environment deployment & handover complete
    .                                       :crit, milestone, t1, 2026-10-13, 0d
    section Final Demo
    .                                       :crit, milestone, d1, 2026-10-16, 0d
    section Phase 6: Integration & Internal QA
    .                                       :done, p6, 2026-10-16, 2026-10-29
    section UAT Handover
    .                                       :milestone, m1, 2026-11-02, 0d
    section Hypercare
    .                                       :h1, 2026-11-02, 2026-11-16
    section Accelerated schedule
    Accelerated                            :crit, accel, 2026-10-13, 2026-11-02
