%%{init: {'theme':'base','themeCSS':'* { font-family: Helvetica Neue, Helvetica, Arial, sans-serif !important; } .milestoneText { font-style: normal !important; } .grid .tick text { display: none; } .grid ~ .grid .tick text { display: block; font-size: 13px; }','themeVariables':{'fontFamily':'Helvetica Neue, Arial, sans-serif','taskBkgColor':'#2E7DD1','taskBorderColor':'#2E7DD1','taskTextColor':'#ffffff','taskTextDarkColor':'#0B2A4A','taskTextOutsideColor':'#0B2A4A','critBkgColor':'#0B2A4A','critBorderColor':'#0B2A4A','sectionBkgColor':'#EAF2FB','altSectionBkgColor':'#ffffff','sectionBkgColor2':'#EAF2FB','gridColor':'#c5ced6','textColor':'#0B2A4A'},'gantt':{'barHeight':30,'barGap':7,'fontSize':17,'sectionFontSize':17,'leftPadding':200,'topPadding':20,'rightPadding':40,'topAxis':true}}}%%
